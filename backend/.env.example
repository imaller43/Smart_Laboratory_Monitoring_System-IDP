# ============================================================================
# Smart Laboratory Safety Monitoring System — Cloud Backend Environment
# Stack: Eclipse Mosquitto 2.0 + InfluxDB v2.7 + Node-RED 4.0 + Cloudflare
# Host : Microsoft Azure Standard B2ats v2 (2 vCPUs, 1 GiB RAM + 2 GB Swap)
#
# Copy this file to `.env` and replace all placeholder values before starting.
# NEVER commit `.env` to Git!
# ============================================================================

TZ=Asia/Kuala_Lumpur

# ----------------------------------------------------------------------------
# 1. Cloudflare Zero Trust Tunnel (ikmaliman.my)
# Create a dedicated tunnel (e.g. "azure-lab-safety") in Cloudflare Zero Trust
# -> Networks -> Tunnels and paste the Docker tunnel token below.
# ----------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN= --token eyJhIjoiMzM2M2M3NzE2NzkyM2U1NWI0OTI3YjgwMDY4MzM3ZDEiLCJ0IjoiZjEzYWNlMDctZDlmOC00NGQ4LWJhZDItZDEzZTM3MDMwMDQ2IiwicyI6IllXUTBaVFUwT1dVdE5XTTNOUzAwWVRNekxXSTJZVE10WXpGalpXTTFNakZsTUdZeSJ9

# ----------------------------------------------------------------------------
# 2. Eclipse Mosquitto 2.0 MQTT Broker
# Run `bash scripts/init-secrets.sh` after editing `.env` to generate the
# gitignored Mosquitto hashed password file and Node-RED initial credentials.
# ----------------------------------------------------------------------------
# Internal Node-RED MQTT user
MQTT_NODERED_USER=nodered_backend
MQTT_NODERED_PASS=replace_with_strong_nodered_mqtt_pass

# ESP32 device credentials (enter these into each ESP32 iot.html portal)
MQTT_ESP32_MAIN_USER=lab_main_s3
MQTT_ESP32_MAIN_PASS=replace_with_strong_esp32_main_pass

MQTT_ESP32_GATEWAY_USER=lab_gateway_mini
MQTT_ESP32_GATEWAY_PASS=replace_with_strong_esp32_gateway_pass

# ----------------------------------------------------------------------------
# 3. InfluxDB v2.7 (Time-Series Storage)
# Used to auto-bootstrap InfluxDB on first boot.
# ----------------------------------------------------------------------------
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=replace_with_strong_influx_pass
INFLUXDB_ORG=idp-lab
INFLUXDB_BUCKET=lab_safety
INFLUXDB_RETENTION=90d
# Generate with: openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=replace_with_64char_hex_influx_token

# ----------------------------------------------------------------------------
# 4. Node-RED (Middleware, REST API, WebSocket & Alerting)
# ----------------------------------------------------------------------------
NODERED_ADMIN_USER=admin
# Plain password (hashed automatically by settings.js at startup) OR set a
# pre-computed bcrypt hash in NODERED_ADMIN_PASSWORD_HASH instead.
NODERED_ADMIN_PASSWORD=replace_with_strong_nodered_admin_pass
NODERED_ADMIN_PASSWORD_HASH=

# Encryption key for Node-RED flows_cred.json (generate with: openssl rand -hex 24)
NODERED_CREDENTIAL_SECRET=replace_with_random_credential_secret

# Comma-separated allowed CORS origins for Netlify frontend + local dev
# Example: https://your-site.netlify.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional API key required for admin POST endpoints like /api/ota/trigger
# Send via HTTP header: X-API-Key: <API_ADMIN_KEY>
API_ADMIN_KEY=replace_with_random_api_admin_key

# ----------------------------------------------------------------------------
# 5. Telegram Bot Alerts (Handled exclusively by Node-RED)
# Leave blank to temporarily disable Telegram notifications without errors.
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------------------------------------------------------
# 6. Firebase Cloud Messaging (FCM HTTP v1 — Browser Push Notifications)
# Place your Firebase Admin SDK JSON file at:
#   backend/nodered/secrets/firebase-service-account.json
# If the file is missing, FCM gracefully disables itself until you add it.
# ----------------------------------------------------------------------------
FCM_TOPIC=lab-alerts
FCM_SERVICE_ACCOUNT_PATH=/data/secrets/firebase-service-account.json
# URL opened when a user clicks the browser push notification (your Netlify site)
FRONTEND_DASHBOARD_URL=https://lab-api.ikmaliman.my
