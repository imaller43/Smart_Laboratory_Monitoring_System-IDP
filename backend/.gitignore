# Environment variables & secrets (Telegram Bot Token, DB passwords, MQTT credentials)
.env
.env.*
!.env.example
secrets/
nodered/secrets/
*firebase*adminsdk*.json
firebase-service-account.json
mosquitto/passwd
emqx/auth-built-in-db-bootstrap.csv
backups/

# Docker persistent volumes & runtime data
data/
volumes/
mosquitto/data/
mosquitto/log/
emqx/data/
emqx/log/
influxdb/
mysql/

# Node-RED runtime modules & secret credentials (commit flows.json, NOT flows_cred.json)
nodered/node_modules/
nodered/.config*.json
nodered/flows_cred.json
nodered/context/
nodered/lib/
nodered/.sessions.json
nodered/package.json
nodered/package-lock.json
*.backup

# Node.js / Python helper scripts (if used)
node_modules/
__pycache__/
*.pyc
venv/
.venv/

# Local databases & logs
*.db
*.sqlite
*.log
